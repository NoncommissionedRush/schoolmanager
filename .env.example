# Copy to .env and adjust if needed: cp .env.example .env
# Matches the Postgres service in docker-compose.yml.
DATABASE_URL="postgresql://schoolmanager:schoolmanager@localhost:5432/schoolmanager?schema=public"

# Auth.js secret used to sign session cookies. Any long random string; make a
# new one with `openssl rand -base64 32`. Never reuse this value in production.
AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"
