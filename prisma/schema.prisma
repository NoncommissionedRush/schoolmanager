// Prisma schema — https://pris.ly/d/prisma-schema
// Convention: every tenant-owned table carries `schoolId` (column `school_id`)
// and every query against it must be scoped by that id.
//
// Cross-school references are made impossible at the database level: every
// tenant-owned model exposes `@@unique([schoolId, id])`, and relations between
// tenant-owned models use the composite key `[schoolId, xId]`, so a row can
// only point at rows of its own school. Optional composite relations use
// `onDelete: Restrict` because the default (SetNull) would try to null
// `school_id` as well.
//
// Times of day (slots, availability) are stored as minutes since midnight in
// the school's timezone (`School.timezone`); concrete lessons store absolute
// `timestamptz` instants. Weekdays follow ISO 8601: 1 = Monday … 7 = Sunday.
// See docs/architecture/data-model.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum GroupType {
  GROUP
  ONE_ON_ONE
}

enum RoomKind {
  PHYSICAL
  ONLINE
}

enum AvailabilityKind {
  /// Recurring every week on `weekday` between `startMinute` and `endMinute`.
  WEEKLY_UNAVAILABLE
  /// One-off: unavailable on `date` (whole day when minutes are null).
  DATE_UNAVAILABLE
  /// One-off exception: available on `date` despite a weekly rule.
  DATE_AVAILABLE
}

enum LessonStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum ReplacementStatus {
  AUTO_APPROVED
  APPROVED
  REJECTED
  OVERRIDDEN
  /// Cancelled by the student, or released because the target lesson was
  /// cancelled (`cancelReason`). Kept for history.
  CANCELLED
}

/// How a generator draft applies (docs/architecture/generator.md §5.2).
enum DraftMode {
  /// Unpublished term: the draft replaces the term's slots.
  REPLACE
  /// Published term: only groups without live slots from `effectiveFrom`.
  FILL
  /// Published term: every group is reconsidered from `effectiveFrom`.
  REPLAN_FROM
}

enum DraftAssignmentOrigin {
  GENERATED
  MANUAL
  IMPORTED
}

enum GeneratorRunStatus {
  RUNNING
  DONE
  CANCELLED
  FAILED
}

enum MakeupCreditStatus {
  AVAILABLE
  USED
  EXPIRED
}

/// Phase 5 in-app notifications (docs/architecture/phase5-rules.md §2.2).
enum NotificationType {
  LESSON_CANCELLED
  LESSON_MOVED
  SUBSTITUTE_ASSIGNED
  SUBSTITUTE_REMOVED
  ABSENCE_REPORTED
  REPLACEMENT_BOOKED
  REPLACEMENT_ENDED
  REPLACEMENT_MOVED
  REPLACEMENT_REVIEW_PENDING
  TIMETABLE_PUBLISHED
  TIMETABLE_CHANGED
  CALENDAR_FEED_REVOKED
}

/// Out-of-app channels; IN_APP is the Notification row itself and never
/// gets a delivery row (docs/architecture/phase5-rules.md §2.6).
enum NotificationChannel {
  IN_APP
  EMAIL
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// ---------------------------------------------------------------------------
// Tenancy & people
// ---------------------------------------------------------------------------

model School {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String   @unique
  /// IANA timezone used to interpret slot times, e.g. "Europe/Bratislava".
  timezone              String   @default("Europe/Bratislava")
  /// ISO weekdays lessons are normally held on (default Mon–Sat). Outside
  /// them, or outside the day window below, the timetable editor warns.
  teachingWeekdays      Int[]    @default([1, 2, 3, 4, 5, 6]) @map("teaching_weekdays")
  /// Teaching day window, minutes since midnight (default 07:00–21:00).
  dayStartMinute        Int      @default(420) @map("day_start_minute")
  dayEndMinute          Int      @default(1260) @map("day_end_minute")
  /// A cancellation earns a makeup credit only this long before the lesson
  /// starts (0–20160, i.e. up to 14 days; docs/architecture/replacements.md §2).
  absenceCutoffMinutes  Int      @default(1440) @map("absence_cutoff_minutes")
  /// A makeup credit can be used up to this many days after the missed
  /// lesson's date (1–365).
  makeupCreditValidDays Int      @default(30) @map("makeup_credit_valid_days")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  memberships            Membership[]
  teacherProfiles        TeacherProfile[]
  studentProfiles        StudentProfile[]
  levels                 Level[]
  courses                Course[]
  groups                 Group[]
  groupMemberships       GroupMembership[]
  rooms                  Room[]
  terms                  Term[]
  holidays               Holiday[]
  teacherAvailability    TeacherAvailability[]
  timetableSlots         TimetableSlot[]
  lessons                Lesson[]
  lessonLogs             LessonLog[]
  teacherNotes           TeacherNote[]
  absenceReports         AbsenceReport[]
  replacementRequests    ReplacementRequest[]
  makeupCredits          MakeupCredit[]
  auditLogs              AuditLog[]
  groupLessonTimes       GroupLessonTime[]
  teacherLevels          TeacherLevel[]
  groupTermSkips         GroupTermSkip[]
  timetableDrafts        TimetableDraft[]
  draftAssignments       TimetableDraftAssignment[]
  generatorRuns          GeneratorRun[]
  notifications          Notification[]
  notificationDeliveries NotificationDelivery[]
  teacherRatings         TeacherRating[]
  calendarFeeds          CalendarFeed[]

  @@map("schools")
}

/// A person. Not tenant-owned (sign-in looks users up by email before a
/// school is known), but every user belongs to exactly one school: their
/// single `Membership` (decision 2026-10-14,
/// docs/architecture/multi-school-users.md).
model User {
  id            String    @id @default(uuid()) @db.Uuid
  /// Stored lower-cased; sign-in compares case-insensitively.
  email         String    @unique
  name          String
  /// bcrypt hash; null for users who cannot sign in with a password.
  passwordHash  String?   @map("password_hash")
  /// Auth.js: set once an email provider (magic link) verifies the address.
  emailVerified DateTime? @map("email_verified")
  /// Auth.js: avatar URL from an OAuth provider.
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  /// Soft delete; a deleted user can no longer sign in ("account disabled").
  deletedAt     DateTime? @map("deleted_at")

  accounts             Account[]
  memberships          Membership[]
  teacherProfiles      TeacherProfile[]
  studentProfiles      StudentProfile[]
  reportedAbsences     AbsenceReport[]
  reviewedReplacements ReplacementRequest[]
  auditLogs            AuditLog[]
  groupTermSkips       GroupTermSkip[]
  timetableDrafts      TimetableDraft[]
  generatorRuns        GeneratorRun[]
  notifications        Notification[]       @relation("NotificationRecipient")
  actedNotifications   Notification[]       @relation("NotificationActor")
  hiddenRatings        TeacherRating[]
  calendarFeeds        CalendarFeed[]

  @@map("users")
}

/// A user's role in their school. One membership per user: one school and one
/// role (decisions 2026-10-14, docs/design/app-layout.md §9 and
/// docs/architecture/multi-school-users.md); authorization checks this row,
/// never the existence of a Teacher/StudentProfile.
model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
  @@unique([schoolId, id])
  @@unique([userId])
  @@map("memberships")
}

/// Auth.js: an external identity (OAuth account) linked to a user. Unused
/// while only email + password sign-in is enabled; shaped for
/// `@auth/prisma-adapter` so OAuth providers can be added later.
model Account {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Auth.js: one-time tokens for email (magic link) sign-in. Unused until an
/// email provider is enabled.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model TeacherProfile {
  id                String   @id @default(uuid()) @db.Uuid
  schoolId          String   @map("school_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  bio               String?
  /// Hex color used for the teacher's lessons in timetable views.
  color             String?
  /// Hard weekly maximum for the generator, a warning for manual choices;
  /// null = none (CHECK 15–6000; docs/architecture/generator.md §2.3).
  maxMinutesPerWeek Int?     @map("max_minutes_per_week")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  availability      TeacherAvailability[]
  timetableSlots    TimetableSlot[]
  lessons           Lesson[]                   @relation("LessonTeacher")
  substituteLessons Lesson[]                   @relation("LessonSubstitute")
  lessonLogs        LessonLog[]                @relation("LessonLogAuthor")
  editedLessonLogs  LessonLog[]                @relation("LessonLogEditor")
  notes             TeacherNote[]
  levels            TeacherLevel[]
  draftAssignments  TimetableDraftAssignment[]
  ratings           TeacherRating[]

  @@unique([schoolId, userId])
  @@unique([schoolId, id])
  @@index([userId])
  @@map("teacher_profiles")
}

model StudentProfile {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Current skill level; replacement lessons must match it.
  levelId   String?  @map("level_id") @db.Uuid
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  level  Level? @relation(fields: [schoolId, levelId], references: [schoolId, id], onDelete: Restrict)

  groupMemberships    GroupMembership[]
  notesAbout          TeacherNote[]
  absenceReports      AbsenceReport[]
  replacementRequests ReplacementRequest[]
  makeupCredits       MakeupCredit[]
  teacherRatings      TeacherRating[]

  @@unique([schoolId, userId])
  @@unique([schoolId, id])
  @@index([userId])
  @@map("student_profiles")
}

// ---------------------------------------------------------------------------
// Academics
// ---------------------------------------------------------------------------

/// Skill level, e.g. CEFR A1–C2. `rank` orders levels (lower = easier).
/// Archived levels (`archivedAt`) are hidden from pickers; data using them stays.
model Level {
  id         String    @id @default(uuid()) @db.Uuid
  schoolId   String    @map("school_id") @db.Uuid
  code       String
  name       String
  rank       Int
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  school   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students StudentProfile[]
  courses  Course[]
  groups   Group[]
  teachers TeacherLevel[]

  @@unique([schoolId, code])
  @@unique([schoolId, rank])
  @@unique([schoolId, id])
  @@map("levels")
}

/// What is taught (e.g. "General English B1"); groups are concrete classes.
model Course {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  levelId     String   @map("level_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  level  Level   @relation(fields: [schoolId, levelId], references: [schoolId, id], onDelete: Restrict)
  groups Group[]

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@map("courses")
}

/// A class that meets regularly: a group lesson or a 1-on-1 (capacity 1).
model Group {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  courseId  String?   @map("course_id") @db.Uuid
  levelId   String    @map("level_id") @db.Uuid
  type      GroupType
  name      String
  capacity  Int
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school           School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course           Course?                    @relation(fields: [schoolId, courseId], references: [schoolId, id], onDelete: Restrict)
  level            Level                      @relation(fields: [schoolId, levelId], references: [schoolId, id], onDelete: Restrict)
  memberships      GroupMembership[]
  timetableSlots   TimetableSlot[]
  lessons          Lesson[]
  teacherNotes     TeacherNote[]
  lessonTimes      GroupLessonTime[]
  termSkips        GroupTermSkip[]
  draftAssignments TimetableDraftAssignment[]

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@index([schoolId, levelId])
  @@map("groups")
}

/// A group's regular weekly lesson; applies to every term the group runs in.
/// Read by the generator; saving it never changes live slots
/// (docs/architecture/generator.md §2.1).
model GroupLessonTime {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  /// ISO weekday 1–7.
  weekday     Int
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  roomId      String   @map("room_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  group  Group  @relation(fields: [schoolId, groupId], references: [schoolId, id], onDelete: Cascade)
  room   Room   @relation(fields: [schoolId, roomId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@index([schoolId, groupId])
  @@index([schoolId, roomId, weekday])
  @@map("group_lesson_times")
}

/// "Skip this term": the group takes no part in this term's assignment.
model GroupTermSkip {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  termId      String   @map("term_id") @db.Uuid
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  group     Group  @relation(fields: [schoolId, groupId], references: [schoolId, id], onDelete: Cascade)
  term      Term   @relation(fields: [schoolId, termId], references: [schoolId, id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([schoolId, groupId, termId])
  @@unique([schoolId, id])
  @@map("group_term_skips")
}

/// Enrolment of a student in a group. `leftAt` keeps history.
model GroupMembership {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  groupId   String    @map("group_id") @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  joinedAt  DateTime  @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  group   Group          @relation(fields: [schoolId, groupId], references: [schoolId, id], onDelete: Cascade)
  student StudentProfile @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)

  @@unique([groupId, studentId])
  @@unique([schoolId, id])
  @@index([schoolId, studentId])
  @@map("group_memberships")
}

// ---------------------------------------------------------------------------
// Resources & calendar
// ---------------------------------------------------------------------------

/// Archived rooms (`archivedAt`) are hidden from pickers and cannot get new
/// slots or lessons; slots and lessons already in them keep running.
model Room {
  id         String    @id @default(uuid()) @db.Uuid
  schoolId   String    @map("school_id") @db.Uuid
  name       String
  kind       RoomKind
  capacity   Int?
  /// Join link for ONLINE rooms.
  meetingUrl String?   @map("meeting_url")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  school         School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableSlots TimetableSlot[]
  lessons        Lesson[]
  lessonTimes    GroupLessonTime[]

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@map("rooms")
}

/// A teaching period (e.g. "Autumn 2026"). Dates are inclusive. A school's
/// terms never share a day (EXCLUDE constraint `terms_no_overlap` in the
/// migration; docs/architecture/data-model.md).
model Term {
  id                   String    @id @default(uuid()) @db.Uuid
  schoolId             String    @map("school_id") @db.Uuid
  name                 String
  startDate            DateTime  @map("start_date") @db.Date
  endDate              DateTime  @map("end_date") @db.Date
  /// Set when the timetable is published; null = draft (hidden from students).
  timetablePublishedAt DateTime? @map("timetable_published_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  holidays       Holiday[]
  timetableSlots TimetableSlot[]
  lessons        Lesson[]
  groupSkips     GroupTermSkip[]
  drafts         TimetableDraft[]
  generatorRuns  GeneratorRun[]
  ratings        TeacherRating[]

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@map("terms")
}

/// Day(s) without lessons. Dates are inclusive. `termId` null = school-wide.
model Holiday {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  termId    String?  @map("term_id") @db.Uuid
  name      String
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// A term's own holidays go with it; school-wide ones (`termId` null) stay.
  term   Term?  @relation(fields: [schoolId, termId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@index([schoolId, startDate])
  @@map("holidays")
}

/// Teacher (un)availability. See `AvailabilityKind` for which fields apply;
/// shape is enforced by a CHECK constraint in the migration.
model TeacherAvailability {
  id          String           @id @default(uuid()) @db.Uuid
  schoolId    String           @map("school_id") @db.Uuid
  teacherId   String           @map("teacher_id") @db.Uuid
  kind        AvailabilityKind
  /// ISO weekday 1–7, WEEKLY_UNAVAILABLE only.
  weekday     Int?
  /// One-off date, DATE_* kinds only.
  date        DateTime?        @db.Date
  /// Minutes since midnight; both null = whole day (DATE_* kinds only).
  startMinute Int?             @map("start_minute")
  endMinute   Int?             @map("end_minute")
  note        String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@index([schoolId, teacherId])
  @@map("teacher_availability")
}

/// A level the teacher may be given by the generator
/// (docs/architecture/generator.md §2.2).
model TeacherLevel {
  id        String @id @default(uuid()) @db.Uuid
  schoolId  String @map("school_id") @db.Uuid
  teacherId String @map("teacher_id") @db.Uuid
  levelId   String @map("level_id") @db.Uuid

  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: Cascade)
  level   Level          @relation(fields: [schoolId, levelId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, teacherId, levelId])
  @@unique([schoolId, id])
  @@index([schoolId, levelId])
  @@map("teacher_levels")
}

// ---------------------------------------------------------------------------
// Timetable & lessons
// ---------------------------------------------------------------------------

/// Recurring weekly template. Lessons are generated from slots per term.
/// A slot is in effect from `validFrom` to `validUntil` (inclusive; null =
/// term start / end). Slots with lessons are never rewritten: an edit ends
/// the slot and continues with a new one, so past lessons keep their
/// template. See docs/architecture/scheduling.md.
model TimetableSlot {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  termId      String    @map("term_id") @db.Uuid
  groupId     String    @map("group_id") @db.Uuid
  teacherId   String    @map("teacher_id") @db.Uuid
  roomId      String?   @map("room_id") @db.Uuid
  weekday     Int
  startMinute Int       @map("start_minute")
  endMinute   Int       @map("end_minute")
  validFrom   DateTime? @map("valid_from") @db.Date
  validUntil  DateTime? @map("valid_until") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term    Term           @relation(fields: [schoolId, termId], references: [schoolId, id], onDelete: Cascade)
  group   Group          @relation(fields: [schoolId, groupId], references: [schoolId, id], onDelete: Restrict)
  teacher TeacherProfile @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: Restrict)
  room    Room?          @relation(fields: [schoolId, roomId], references: [schoolId, id], onDelete: Restrict)
  lessons Lesson[]

  @@unique([schoolId, id])
  @@index([schoolId, termId, weekday])
  @@index([schoolId, teacherId])
  @@index([schoolId, groupId])
  @@map("timetable_slots")
}

/// A concrete dated lesson. The lesson log (with homework), notes, absences and
/// replacements attach here. `teacherId` is the regular teacher;
/// `substituteTeacherId` is set when someone else teaches this instance.
model Lesson {
  id                  String       @id @default(uuid()) @db.Uuid
  schoolId            String       @map("school_id") @db.Uuid
  termId              String       @map("term_id") @db.Uuid
  /// Null for ad-hoc lessons not generated from a slot.
  timetableSlotId     String?      @map("timetable_slot_id") @db.Uuid
  groupId             String       @map("group_id") @db.Uuid
  teacherId           String       @map("teacher_id") @db.Uuid
  substituteTeacherId String?      @map("substitute_teacher_id") @db.Uuid
  roomId              String?      @map("room_id") @db.Uuid
  /// Local date of the slot occurrence (school timezone); set for generated
  /// lessons, null for ad-hoc ones. Stays put when the lesson time is edited.
  occurrenceDate      DateTime?    @map("occurrence_date") @db.Date
  startsAt            DateTime     @map("starts_at") @db.Timestamptz(3)
  endsAt              DateTime     @map("ends_at") @db.Timestamptz(3)
  status              LessonStatus @default(SCHEDULED)
  cancelReason        String?      @map("cancel_reason")
  /// The lesson this one replaces after a 1-on-1 reschedule (ad-hoc lessons
  /// only, CHECK). Permanent history; docs/architecture/replacements.md §7.
  rescheduledFromId   String?      @map("rescheduled_from_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  school            School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Restrict: lessons carry history (logs, notes); a term with lessons
  /// cannot be deleted.
  term              Term            @relation(fields: [schoolId, termId], references: [schoolId, id], onDelete: Restrict)
  timetableSlot     TimetableSlot?  @relation(fields: [schoolId, timetableSlotId], references: [schoolId, id], onDelete: Restrict)
  group             Group           @relation(fields: [schoolId, groupId], references: [schoolId, id], onDelete: Restrict)
  teacher           TeacherProfile  @relation("LessonTeacher", fields: [schoolId, teacherId], references: [schoolId, id], onDelete: Restrict)
  substituteTeacher TeacherProfile? @relation("LessonSubstitute", fields: [schoolId, substituteTeacherId], references: [schoolId, id], onDelete: Restrict)
  room              Room?           @relation(fields: [schoolId, roomId], references: [schoolId, id], onDelete: Restrict)
  rescheduledFrom   Lesson?         @relation("LessonReschedule", fields: [schoolId, rescheduledFromId], references: [schoolId, id], onDelete: Restrict)
  rescheduledTo     Lesson?         @relation("LessonReschedule")

  log              LessonLog?
  teacherNotes     TeacherNote[]
  absenceReports   AbsenceReport[]
  replacementsFrom ReplacementRequest[] @relation("ReplacementOriginal")
  replacementsTo   ReplacementRequest[] @relation("ReplacementTarget")
  makeupCredits    MakeupCredit[]
  /// The credit currently spent on this (rescheduled) lesson.
  spentCredit      MakeupCredit?        @relation("CreditRescheduledLesson")

  /// Makes lesson generation idempotent: one lesson per slot per date, even
  /// after the slot or the lesson has been moved to another time.
  @@unique([timetableSlotId, occurrenceDate])
  @@unique([schoolId, id])
  /// A lesson is rescheduled at most once (re-rescheduling chains on).
  @@unique([schoolId, rescheduledFromId])
  @@index([schoolId, startsAt])
  @@index([schoolId, groupId, startsAt])
  @@index([schoolId, teacherId, startsAt])
  /// Substitute timetables, teaching minutes and "needs cover" (phase5-rules.md §6).
  @@index([schoolId, substituteTeacherId, startsAt])
  @@map("lessons")
}

/// The lesson log (one per lesson): what was covered and the homework for
/// the next lesson. Visible to the group's students. Either text may be
/// empty, never both — a log with both empty is deleted (CHECK constraint).
model LessonLog {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  lessonId    String   @map("lesson_id") @db.Uuid
  /// Who wrote the log first.
  authorId    String   @map("author_id") @db.Uuid
  /// Who saved it last ("Last saved by"); `updatedAt` is the conflict check.
  updatedById String   @map("updated_by_id") @db.Uuid
  /// "What we covered", ≤ 5,000 characters.
  content     String?
  /// Homework for the next lesson, ≤ 2,000 characters.
  homework    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lesson    Lesson         @relation(fields: [schoolId, lessonId], references: [schoolId, id], onDelete: Cascade)
  author    TeacherProfile @relation("LessonLogAuthor", fields: [schoolId, authorId], references: [schoolId, id], onDelete: Restrict)
  updatedBy TeacherProfile @relation("LessonLogEditor", fields: [schoolId, updatedById], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, lessonId])
  @@unique([schoolId, id])
  @@map("lesson_logs")
}

/// INTERNAL note by a teacher about a student, group or lesson. Readable by
/// teachers and admins only — never exposed to students (enforced in
/// src/server, covered by tests).
model TeacherNote {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  studentId String?  @map("student_id") @db.Uuid
  groupId   String?  @map("group_id") @db.Uuid
  lessonId  String?  @map("lesson_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school  School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author  TeacherProfile  @relation(fields: [schoolId, authorId], references: [schoolId, id], onDelete: Restrict)
  student StudentProfile? @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)
  group   Group?          @relation(fields: [schoolId, groupId], references: [schoolId, id], onDelete: Restrict)
  lesson  Lesson?         @relation(fields: [schoolId, lessonId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@index([schoolId, studentId])
  @@index([schoolId, groupId])
  @@index([schoolId, lessonId])
  @@map("teacher_notes")
}

// ---------------------------------------------------------------------------
// Timetable generator (Phase 4, docs/architecture/generator.md)
// ---------------------------------------------------------------------------

/// The generator's proposed teachers for a term (one per term). Read only by
/// the generator service; never by timetable views or the conflict checker.
model TimetableDraft {
  id               String    @id @default(uuid()) @db.Uuid
  schoolId         String    @map("school_id") @db.Uuid
  termId           String    @map("term_id") @db.Uuid
  mode             DraftMode
  /// FILL and REPLAN_FROM: changes apply from this date (CHECK).
  effectiveFrom    DateTime? @map("effective_from") @db.Date
  /// Optimistic concurrency for runs and edits.
  version          Int       @default(0)
  /// SHA-256 of the canonical generator input of the last run (out of date).
  inputFingerprint String?   @map("input_fingerprint")
  generatedAt      DateTime? @map("generated_at")
  /// Objective after construction and at the end, workload per teacher,
  /// previous run's range.
  summary          Json?
  /// Groups without a teacher: group reason, per-teacher reasons, suggestions.
  unassigned       Json      @default("[]")
  /// Overridable conflicts and warnings per group, from the last run or check.
  warnings         Json      @default("[]")
  /// iterations, durationMs, stoppedBy, budget.
  runStats         Json?     @map("run_stats")
  createdById      String?   @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  school      School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term        Term                       @relation(fields: [schoolId, termId], references: [schoolId, id], onDelete: Cascade)
  createdBy   User?                      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  assignments TimetableDraftAssignment[]
  runs        GeneratorRun[]

  @@unique([schoolId, termId])
  @@unique([schoolId, id])
  @@map("timetable_drafts")
}

/// One included group's teacher in a draft.
model TimetableDraftAssignment {
  id        String                @id @default(uuid()) @db.Uuid
  schoolId  String                @map("school_id") @db.Uuid
  draftId   String                @map("draft_id") @db.Uuid
  groupId   String                @map("group_id") @db.Uuid
  /// Null = no teacher.
  teacherId String?               @map("teacher_id") @db.Uuid
  locked    Boolean               @default(false)
  origin    DraftAssignmentOrigin
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  school  School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  draft   TimetableDraft  @relation(fields: [schoolId, draftId], references: [schoolId, id], onDelete: Cascade)
  group   Group           @relation(fields: [schoolId, groupId], references: [schoolId, id], onDelete: Restrict)
  teacher TeacherProfile? @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: Restrict)

  @@unique([draftId, groupId])
  @@unique([schoolId, id])
  @@index([schoolId, teacherId])
  @@map("timetable_draft_assignments")
}

/// One generator run; progress while RUNNING, result summary after. One
/// RUNNING run per term (partial unique index in the migration).
model GeneratorRun {
  id              String             @id @default(uuid()) @db.Uuid
  schoolId        String             @map("school_id") @db.Uuid
  termId          String             @map("term_id") @db.Uuid
  draftId         String             @map("draft_id") @db.Uuid
  status          GeneratorRunStatus @default(RUNNING)
  cancelRequested Boolean            @default(false) @map("cancel_requested")
  maxIterations   Int                @map("max_iterations")
  timeLimitMs     Int                @map("time_limit_ms")
  /// { phase, assigned, total, elapsedMs } while running.
  progress        Json?
  heartbeatAt     DateTime           @default(now()) @map("heartbeat_at")
  /// iterations, durationMs, stoppedBy, assigned, unassigned, workload range.
  result          Json?
  errorCode       String?            @map("error_code")
  startedById     String?            @map("started_by_id") @db.Uuid
  startedAt       DateTime           @default(now()) @map("started_at")
  finishedAt      DateTime?          @map("finished_at")

  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term      Term           @relation(fields: [schoolId, termId], references: [schoolId, id], onDelete: Cascade)
  draft     TimetableDraft @relation(fields: [schoolId, draftId], references: [schoolId, id], onDelete: Cascade)
  startedBy User?          @relation(fields: [startedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@index([schoolId, termId, startedAt])
  @@map("generator_runs")
}

// ---------------------------------------------------------------------------
// Absences & replacements (Phase 3)
// ---------------------------------------------------------------------------

/// A student cancelling an upcoming lesson ("I won't come"), reported by the
/// student or by an admin on their behalf. Final for the student; an admin
/// can delete it. Whether it earned a credit is the credit's existence.
/// See docs/architecture/replacements.md §3.
model AbsenceReport {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  lessonId     String   @map("lesson_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  /// Who reported it: the student's user, or an admin's ("via office").
  /// Null only after that user was deleted. Never a teacher.
  reportedById String?  @map("reported_by_id") @db.Uuid
  /// Optional, ≤ 300 characters; the teacher and admins see it.
  reason       String?
  /// When it was reported; the cutoff is evaluated against this.
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lesson       Lesson         @relation(fields: [schoolId, lessonId], references: [schoolId, id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)
  reportedBy   User?          @relation(fields: [reportedById], references: [id], onDelete: SetNull)
  makeupCredit MakeupCredit?

  @@unique([lessonId, studentId])
  @@unique([schoolId, id])
  @@index([schoolId, studentId])
  @@map("absence_reports")
}

/// Entitlement to one replacement (group) or reschedule (1-on-1), earned by
/// an absence reported before the cutoff. The stored `status` may lag:
/// an AVAILABLE credit past `expiresAt` is EXPIRED (`creditState`), and is
/// brought up to date lazily. See docs/architecture/replacements.md §4.
model MakeupCredit {
  id                  String             @id @default(uuid()) @db.Uuid
  schoolId            String             @map("school_id") @db.Uuid
  studentId           String             @map("student_id") @db.Uuid
  sourceLessonId      String             @map("source_lesson_id") @db.Uuid
  absenceReportId     String             @map("absence_report_id") @db.Uuid
  status              MakeupCreditStatus @default(AVAILABLE)
  /// Start of the local day after "valid until"; usable only before it.
  expiresAt           DateTime           @map("expires_at")
  /// Set with USED, cleared when the credit is released.
  usedAt              DateTime?          @map("used_at")
  /// The ad-hoc lesson a 1-on-1 credit is currently spent on (USED only,
  /// CHECK); cleared on release. History lives on `Lesson.rescheduledFromId`.
  rescheduledLessonId String?            @map("rescheduled_lesson_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  school            School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student           StudentProfile       @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)
  sourceLesson      Lesson               @relation(fields: [schoolId, sourceLessonId], references: [schoolId, id], onDelete: Restrict)
  absenceReport     AbsenceReport        @relation(fields: [schoolId, absenceReportId], references: [schoolId, id], onDelete: Restrict)
  rescheduledLesson Lesson?              @relation("CreditRescheduledLesson", fields: [schoolId, rescheduledLessonId], references: [schoolId, id], onDelete: Restrict)
  replacements      ReplacementRequest[]

  @@unique([studentId, sourceLessonId])
  @@unique([schoolId, id])
  @@unique([schoolId, absenceReportId])
  @@unique([schoolId, rescheduledLessonId])
  @@index([schoolId, studentId, status])
  @@index([schoolId, status, expiresAt])
  @@map("makeup_credits")
}

/// A student attending `targetLesson` (another group, same level) instead of
/// `originalLesson`, booked with a makeup credit. Created AUTO_APPROVED; an
/// admin can approve, reject or override afterwards (`reviewedBy*`). Active =
/// AUTO_APPROVED, APPROVED or OVERRIDDEN; partial unique indexes allow one
/// active booking per credit and per (student, target). See
/// docs/architecture/replacements.md §6.
model ReplacementRequest {
  id               String            @id @default(uuid()) @db.Uuid
  schoolId         String            @map("school_id") @db.Uuid
  studentId        String            @map("student_id") @db.Uuid
  originalLessonId String            @map("original_lesson_id") @db.Uuid
  targetLessonId   String            @map("target_lesson_id") @db.Uuid
  makeupCreditId   String            @map("makeup_credit_id") @db.Uuid
  status           ReplacementStatus @default(AUTO_APPROVED)
  reviewedById     String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt       DateTime?         @map("reviewed_at")
  reviewNote       String?           @map("review_note")
  /// Set iff CANCELLED (CHECK).
  cancelledAt      DateTime?         @map("cancelled_at")
  /// STUDENT | STUDENT_LATE | LESSON_CANCELLED.
  cancelReason     String?           @map("cancel_reason")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        StudentProfile @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)
  originalLesson Lesson         @relation("ReplacementOriginal", fields: [schoolId, originalLessonId], references: [schoolId, id], onDelete: Restrict)
  targetLesson   Lesson         @relation("ReplacementTarget", fields: [schoolId, targetLessonId], references: [schoolId, id], onDelete: Restrict)
  makeupCredit   MakeupCredit   @relation(fields: [schoolId, makeupCreditId], references: [schoolId, id], onDelete: Restrict)
  reviewedBy     User?          @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@index([schoolId, status])
  @@index([schoolId, targetLessonId])
  @@index([schoolId, originalLessonId])
  @@index([schoolId, studentId])
  @@map("replacement_requests")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only record of significant changes (who did what to which entity).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @map("school_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  data       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([schoolId, entityType, entityId])
  @@index([schoolId, createdAt])
  @@map("audit_logs")
}

/// One in-app notification for one user. Rendered at read time from
/// `type` + `params` (no stored text). No FK to the subject, so it never
/// blocks deleting a lesson. See docs/architecture/phase5-rules.md §2.
model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  schoolId    String           @map("school_id") @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  type        NotificationType
  /// teacher | regular | substitute | student | admin — selects the message variant (CHECK).
  audience    String
  /// ICU params, display names snapshotted at creation.
  params      Json             @default("{}")
  /// { kind: "lesson", lessonId } | { kind: "timetable", date } | { kind: "replacementReview" } | { kind: "calendarFeed" }.
  link        Json?
  /// `<audit log id>:<type>:<subject>`; de-duplicates within one action
  /// only (§2.5). Cross-request safety is the action's conditional write.
  sourceKey   String           @map("source_key")
  /// Merges unread notifications about the same subject (§2.5). A partial
  /// unique index allows one unread row per key and recipient.
  coalesceKey String?          @map("coalesce_key")
  actorId     String?          @map("actor_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  readAt      DateTime?        @map("read_at")

  school     School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recipient  User                   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor      User?                  @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  deliveries NotificationDelivery[]

  @@unique([schoolId, id])
  @@unique([schoolId, recipientId, sourceKey])
  /// Inbox page and unread count.
  @@index([schoolId, recipientId, createdAt(sort: Desc), id])
  @@index([schoolId, recipientId, readAt])
  @@map("notifications")
}

/// A notification sent on an out-of-app channel (outbox). Unused in v1: no
/// channel is registered (phase5-rules.md §2.6).
model NotificationDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  schoolId       String              @map("school_id") @db.Uuid
  notificationId String              @map("notification_id") @db.Uuid
  channel        NotificationChannel
  status         DeliveryStatus      @default(PENDING)
  attempts       Int                 @default(0)
  lastError      String?             @map("last_error")
  sentAt         DateTime?           @map("sent_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [schoolId, notificationId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@unique([notificationId, channel])
  @@index([schoolId, status, createdAt])
  @@map("notification_deliveries")
}

/// A student's rating of a teacher for a term. Admin-readable only
/// (docs/architecture/phase5-rules.md §4): teachers never read this table,
/// students only their own rows through src/server/ratings/student.ts.
model TeacherRating {
  id         String    @id @default(uuid()) @db.Uuid
  schoolId   String    @map("school_id") @db.Uuid
  studentId  String    @map("student_id") @db.Uuid
  teacherId  String    @map("teacher_id") @db.Uuid
  termId     String    @map("term_id") @db.Uuid
  /// 1–5 stars (CHECK).
  score      Int
  /// ≤ 1,000 characters (CHECK), null when empty.
  comment    String?
  /// Set by an admin to leave the rating out of averages (e.g. abusive).
  hiddenAt   DateTime? @map("hidden_at")
  hiddenById String?   @map("hidden_by_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  school   School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  StudentProfile @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)
  teacher  TeacherProfile @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: Restrict)
  term     Term           @relation(fields: [schoolId, termId], references: [schoolId, id], onDelete: Restrict)
  hiddenBy User?          @relation(fields: [hiddenById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@unique([schoolId, studentId, teacherId, termId])
  @@index([schoolId, teacherId, termId])
  @@map("teacher_ratings")
}

/// A user's private iCal subscription (phase5-rules.md §5). The token is
/// HMAC(ICAL_TOKEN_SECRET, salt); only its sha256 is stored. A partial
/// unique index allows one active (not revoked) feed per user.
model CalendarFeed {
  id         String    @id @default(uuid()) @db.Uuid
  schoolId   String    @map("school_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  salt       Bytes
  /// Globally unique: the public route looks it up before it knows the school.
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@index([schoolId, userId])
  @@map("calendar_feeds")
}
