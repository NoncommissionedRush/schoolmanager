// Prisma schema — https://pris.ly/d/prisma-schema
// Convention: every tenant-owned table carries `schoolId` (column `school_id`)
// and every query against it must be scoped by that id.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model School {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("schools")
}
